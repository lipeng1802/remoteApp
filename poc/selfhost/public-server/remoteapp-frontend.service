[Unit]
Description=RemoteApp unprivileged device-only HTTPS frontend
Requires=remoteapp-authority.service
After=network.target remoteapp-authority.service

[Service]
Type=simple
User=remoteapp-pre
Group=remoteapp-pre
ExecStart=/opt/remoteapp-prerelease/device-frontend /var/lib/remoteapp-prerelease @RELEASE_ROOT@ remoteapp-prerelease 1 127.0.0.1:8444 /run/remoteapp-authority/authority.sock 0
Restart=no
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
ReadOnlyDirectories=/var/lib/remoteapp-prerelease
InaccessibleDirectories=/var/lib/remoteapp-authority /etc/remoteapp-poc
CapabilityBoundingSet=
LimitNOFILE=128
TimeoutStopSec=10
StandardOutput=journal
StandardError=null

[Install]
WantedBy=multi-user.target
