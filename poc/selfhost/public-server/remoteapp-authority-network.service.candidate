# Candidate ONLY. Not installed/enabled by a build or preflight.
# Substitute reviewed public anchor/UID/GID; network.json is operator-local.
[Unit]
Description=RemoteApp sole authority with supervised network (candidate)
After=network.target remoteapp-poc.service
# Runtime supervision must observe an outage and exit nonzero. Requires would
# let systemd turn provider loss into an apparently normal dependent stop.
Wants=remoteapp-poc.service

[Service]
Type=simple
User=root
Group=root
ExecStartPre=/opt/remoteapp-prerelease/authority-daemon /etc/remoteapp-authority/service-profile.json @RELEASE_ROOT@ remoteapp-prerelease 1 /var/lib/remoteapp-authority /run/remoteapp-authority/authority.sock @FRONTEND_UID@ @FRONTEND_GID@ --check-network-config /etc/remoteapp-authority/network.json
ExecStart=/opt/remoteapp-prerelease/authority-daemon /etc/remoteapp-authority/service-profile.json @RELEASE_ROOT@ remoteapp-prerelease 1 /var/lib/remoteapp-authority /run/remoteapp-authority/authority.sock @FRONTEND_UID@ @FRONTEND_GID@ --network-config /etc/remoteapp-authority/network.json
Restart=no
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
ReadOnlyDirectories=/var/lib/remoteapp-prerelease /etc/remoteapp-authority
ReadWriteDirectories=/var/lib/remoteapp-authority /run/remoteapp-authority /var/lib/remoteapp-verifier /var/lib/remoteapp-network-policy
# Fixed provider CLI uses its 0600 admin socket beneath another service UID's
# 0700 directory. Root needs DAC override; do not loosen provider permissions.
# Pinned tsnet on root/CentOS needs SO_BINDTODEVICE when SO_MARK is unavailable.
# CAP_NET_RAW permits that fallback without granting CAP_NET_ADMIN.
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_NET_RAW
LimitNOFILE=128
# Daemon allows 30 seconds for actual network join. A forced systemd timeout
# is NOT graceful shutdown; retain locks/state and require operator review.
TimeoutStopSec=45
StandardOutput=journal
StandardError=null

[Install]
WantedBy=multi-user.target
