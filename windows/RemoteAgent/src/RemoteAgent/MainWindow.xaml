<Window x:Class="RemoteAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal Remote Desktop Agent"
        Height="220"
        Width="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="28">
        <TextBlock FontSize="22" FontWeight="SemiBold"
                   Text="Personal Remote Desktop Agent" />
        <TextBlock Margin="0,14,0,0" Foreground="DimGray"
                   Text="Protocol baseline ready" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Networking, capture, and input are intentionally disabled in P0." />
    </StackPanel>
</Window>
