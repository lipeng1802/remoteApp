<Window x:Class="RemoteAgent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal Remote Desktop · 屏幕共享" Height="535" Width="650"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <StackPanel Margin="28">
        <TextBlock FontSize="24" FontWeight="SemiBold" Text="共享 Windows 主屏" />
        <TextBlock Margin="0,12,0,0" Text="默认只读 · 最高 1280 × 720 · 10 FPS" Foreground="DimGray" />
        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Text="点击开始后等待已配对的 Mac。认证成功才采集画面；停止或关闭窗口会立即结束共享。" />
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <TextBlock Text="画质：" VerticalAlignment="Center" />
            <ComboBox x:Name="QualitySelector" SelectedIndex="1" Width="390">
                <ComboBoxItem Content="低带宽 · 720p，降低画质以减少传输量" />
                <ComboBoxItem Content="标准 · 720p，平衡清晰度和传输量" />
                <ComboBoxItem Content="清晰 · 720p，细节较好，需要更多带宽" />
            </ComboBox>
        </StackPanel>
        <CheckBox x:Name="ControlConsent" Margin="0,14,0,0"
                  Content="允许本次远程控制（会真实操作此 Windows）"
                  Click="ControlConsent_Click" />
        <TextBlock x:Name="ControlText" Margin="20,6,0,0" FontSize="12" Foreground="DarkRed"
                   Text="未允许：本次共享只发送画面" TextWrapping="Wrap" />
        <TextBlock x:Name="StatusText" Margin="0,20,0,0" FontWeight="SemiBold" Text="未共享" TextWrapping="Wrap" />
        <TextBlock x:Name="MetricsText" Margin="0,8,0,0" FontSize="12" TextWrapping="Wrap" Foreground="DimGray" />
        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <Button x:Name="StartButton" Content="开始共享" Padding="18,8" Click="Start_Click" />
            <Button x:Name="StopButton" Content="停止共享" Margin="12,0,0,0" Padding="18,8" IsEnabled="False" Click="Stop_Click" />
        </StackPanel>
        <TextBlock Margin="0,16,0,4" Text="首次连接请在 Mac 核对此证书 SHA-256：" FontSize="12" />
        <TextBox x:Name="FingerprintText" IsReadOnly="True" BorderThickness="0" FontSize="11" TextWrapping="Wrap" />
    </StackPanel>
</Window>
